{
  "rules": {
    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" },
      ".write": false
    },
    "config": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "students": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "profile": {
          ".write": "auth != null && auth.uid === $uid && root.child('students').child($uid).child('status').val() !== 'approved' && root.child('config/sessionOpen').val() !== false",
          ".validate": "newData.hasChildren(['name', 'id', 'requestedAt']) && newData.child('id').isString() && newData.child('id').val().matches(/^20[0-9]{7}$/) && newData.child('name').isString() && newData.child('name').val().length < 80"
        },
        "presence": { ".write": "auth != null && auth.uid === $uid" },
        "work": { ".write": "auth != null && auth.uid === $uid && root.child('students').child($uid).child('status').val() === 'approved'" },
        "status": { ".validate": "newData.isString() && (newData.val() === 'approved' || newData.val() === 'rejected' || newData.val() === 'pending')" },
        "overrides": { "$q": { ".validate": "newData.isNumber()" } }
      }
    }
  }
}
